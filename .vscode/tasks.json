{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build HTML (Modules -> index.html)",
            "type": "shell",
            "command": "node scripts/build.js",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Watch HTML Modules (Live Auto-Rebuild)",
            "type": "shell",
            "command": "node scripts/build.js --watch",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": false
            }
        },
        {
            "label": "Start Local Server (Python)",
            "type": "shell",
            "command": "python3 -m http.server 8000",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            }
        }
    ]
}
